---
import { SITE_TITLE } from '../consts';
---

<footer class="site-footer">
	<div class="footer-inner"><a href="/" class="footer-brand">{SITE_TITLE}<span> ✳</span></a><p>Astro でつくった、小さな個人ブログ。</p><div class="footer-bottom"><span>© {new Date().getFullYear()} kuroneko52</span><a href="/rss.xml">RSS フィード ↗</a></div></div>
</footer>

<style>
	.site-footer { margin-top: 72px; padding: 30px 20px 22px; border-top: 1px solid var(--line); }
	.footer-inner { width: min(1040px, 100%); margin: auto; }
	.footer-brand { color: var(--ink); font-size: 13px; font-weight: 700; text-decoration: none; }
	.footer-brand span { color: var(--astro); }
	.site-footer p { margin: 4px 0 22px; color: var(--muted); font-size: 11px; }
	.footer-bottom { display: flex; justify-content: space-between; padding-top: 12px; border-top: 1px solid var(--line); color: var(--muted); font-size: 10px; }
	.footer-bottom a { color: inherit; text-decoration: none; }
</style>
