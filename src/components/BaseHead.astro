---
// Import site-wide styles and metadata for every page.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = FallbackImage } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#151515" />
<!-- Critical styles are in the document head so navigation is never painted unstyled while page CSS loads. -->
<style is:inline>
	:root {
		color-scheme: dark;
		--paper: #151515;
		--surface: #1d1d1d;
		--ink: #e9e7e2;
		--muted: #a6a39d;
		--line: #393939;
		--astro: #f27b52;
		font-family: Atkinson, 'Hiragino Kaku Gothic ProN', 'Yu Gothic', sans-serif;
		color: var(--ink);
		background-color: var(--paper);
	}
	html { min-height: 100%; background-color: var(--paper); }
	body { min-height: 100vh; margin: 0; background-color: var(--paper); color: var(--ink); font-family: inherit; }
	*, *::before, *::after { box-sizing: border-box; }

	/* Current site header */
	.site-header { border-bottom: 1px solid var(--line); background-color: var(--paper); }
	.site-header nav { width: min(1040px, calc(100% - 40px)); min-height: 72px; margin-inline: auto; display: flex; align-items: center; gap: 30px; }
	.site-header .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-size: 15px; font-weight: 750; text-decoration: none; white-space: nowrap; }
	.site-header .brand-mark { display: grid; width: 27px; height: 27px; flex: 0 0 auto; place-items: center; border: 1px solid var(--astro); color: var(--astro); font-family: monospace; font-size: 16px; }
	.site-header .nav-links { display: flex; align-items: center; gap: 26px; margin-left: auto; }
	.site-header .nav-links a { color: var(--muted); font-size: 13px; text-decoration: none; }
	.site-header .nav-links a:hover, .site-header .nav-links a.active { color: var(--astro); }
	.site-header .rss-link { padding: 5px 10px; border: 1px solid var(--line); border-radius: 3px; color: var(--muted); font-size: 11px; text-decoration: none; }
	.site-header .rss-link span { margin-left: 4px; }

	/* Keep the original starter header stable too, including pages still using it. */
	header:not(.site-header) { margin: 0; padding: 0 1em; background-color: var(--paper); }
	header:not(.site-header) nav { display: flex; align-items: center; justify-content: space-between; }
	header:not(.site-header) nav h2 { margin: 0; font-size: 1em; }
	header:not(.site-header) nav a { padding: 1em .5em; color: var(--ink); text-decoration: none; }
	header:not(.site-header) .social-links, header:not(.site-header) .social-links a { display: flex; }

	@media (max-width: 600px) {
		.site-header nav { width: calc(100% - 28px); min-height: 64px; flex-wrap: wrap; gap: 0 12px; }
		.site-header .brand { font-size: 13px; }
		.site-header .brand-mark { width: 23px; }
		.site-header .nav-links { order: 3; width: 100%; justify-content: center; gap: 24px; padding-bottom: 13px; }
	}
	@media (max-width: 720px) { header:not(.site-header) .social-links { display: none; } }
</style>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<meta name="generator" content={Astro.generator} />
<Font cssVariable="--font-atkinson" preload />
<link rel="canonical" href={canonicalURL} />
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
<meta name="twitter:card" content="summary_large_image" />
