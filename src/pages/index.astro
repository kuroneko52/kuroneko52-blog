---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ja">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main class="home">
			<section class="welcome"><p class="eyebrow">PERSONAL BLOG</p><h1>日々のことを、<br />自分の言葉で。</h1><p class="intro">暮らしのなかで考えたこと、つくったもの、心に残ったこと。忘れないように、少しずつ書いています。</p><a class="all-link" href="/blog">記事を読む <span aria-hidden="true">→</span></a></section>
			<section class="recent" aria-labelledby="recent-title"><div class="section-heading"><h2 id="recent-title">最近の記事</h2><a href="/blog">記事一覧 <span aria-hidden="true">→</span></a></div>
				{posts.length > 0 ? <ol class="post-list">{posts.slice(0, 5).map((post) => <li><a href={`/blog/${post.id}/`}><time><FormattedDate date={post.data.pubDate} /></time><span class="post-copy"><strong>{post.data.title}</strong><span>{post.data.description}</span></span><span class="arrow" aria-hidden="true">↗</span></a></li>)}</ol> : <p class="empty">記事はまだありません。</p>}
			</section>
			<p class="about-link"><a href="/about">このブログについて <span aria-hidden="true">→</span></a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home { width: min(720px, calc(100% - 40px)); margin: auto; }
	.welcome { padding: 86px 0 74px; }
	.eyebrow { margin-bottom: 16px; color: var(--astro); font-family: var(--font-atkinson), sans-serif; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
	h1 { margin: 0 0 20px; font-size: clamp(35px, 6vw, 48px); font-weight: 500; letter-spacing: -.055em; line-height: 1.45; }
	.intro { max-width: 500px; margin: 0 0 22px; color: var(--muted); font-size: 15px; line-height: 2; }
	.all-link, .section-heading > a, .about-link a { color: var(--astro); font-size: 12px; text-decoration: none; }
	.all-link span, .section-heading > a span, .about-link a span { margin-left: 5px; }
	.recent { padding-top: 21px; border-top: 1px solid var(--line); }
	.section-heading { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 9px; }
	.section-heading h2 { margin: 0; font-size: 15px; font-weight: 600; }
	.post-list { margin: 0; padding: 0; list-style: none; }
	.post-list li { border-top: 1px solid var(--line); }
	.post-list li:last-child { border-bottom: 1px solid var(--line); }
	.post-list li > a { display: grid; grid-template-columns: 102px 1fr 18px; align-items: baseline; gap: 14px; padding: 16px 2px; text-decoration: none; }
	.post-list time { color: var(--muted); font-size: 11px; white-space: nowrap; }
	.post-copy { display: grid; gap: 4px; }
	.post-copy strong { font-size: 14px; font-weight: 600; line-height: 1.6; }
	.post-copy > span { color: var(--muted); font-size: 12px; line-height: 1.7; }
	.arrow { color: var(--muted); font-size: 12px; text-align: right; }
	.post-list a:hover strong, .post-list a:hover .arrow { color: var(--astro); }
	.empty { color: var(--muted); font-size: 13px; }
	.about-link { margin: 25px 0 0; text-align: right; }
	@media (max-width: 600px) { .home { width: calc(100% - 32px); } .welcome { padding: 58px 0 52px; } .post-list li > a { grid-template-columns: 82px 1fr 14px; gap: 10px; padding: 14px 0; } .post-copy strong { font-size: 13px; } .post-copy > span { font-size: 11px; } }
</style>
