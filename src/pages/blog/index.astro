---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ja">
	<head><BaseHead title={`記事一覧 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} /></head>
	<body><Header /><main class="archive">
		<header class="archive-header"><p class="eyebrow">ARCHIVE</p><h1>記事一覧</h1><p>書いたものを、新しい順に。</p></header>
		<div class="archive-tools"><label for="post-search">記事を検索</label><input id="post-search" type="search" placeholder="題名や本文の概要から検索" autocomplete="off" /><p class="result-count" aria-live="polite">全 {posts.length} 件</p></div>
		<div class="post-list">{posts.map((post) => <article class="post-item" data-search={`${post.data.title} ${post.data.description}`}><a href={`/blog/${post.id}/`}><time><FormattedDate date={post.data.pubDate} /></time><span class="post-copy"><h2>{post.data.title}</h2><span class="excerpt">{post.data.description}</span></span><span class="arrow" aria-hidden="true">↗</span></a></article>)}</div>
		<p class="no-results" hidden>該当する記事はありません。</p><a class="back-link" href="/">← ホームへ戻る</a>
	</main><Footer />
	<script>
		const search = document.querySelector<HTMLInputElement>('#post-search');
		const items = Array.from(document.querySelectorAll<HTMLElement>('.post-item'));
		const count = document.querySelector<HTMLElement>('.result-count');
		const empty = document.querySelector<HTMLElement>('.no-results');
		search?.addEventListener('input', () => {
			const query = search.value.trim().normalize('NFKC').toLocaleLowerCase('ja');
			let visible = 0;
			for (const item of items) {
				const matches = (item.dataset.search ?? '').normalize('NFKC').toLocaleLowerCase('ja').includes(query);
				item.hidden = !matches;
				if (matches) visible += 1;
			}
			if (count) count.textContent = query ? `${visible} 件` : `全 ${items.length} 件`;
			if (empty) empty.hidden = visible !== 0;
		});
	</script>
	</body>
</html>

<style>
	.archive { width: min(720px, calc(100% - 40px)); margin: auto; padding-top: 65px; }
	.archive-header { margin-bottom: 35px; }
	.eyebrow { margin: 0 0 8px; color: var(--astro); font-size: 10px; letter-spacing: .12em; }
	h1 { margin: 0 0 7px; font-size: 36px; font-weight: 500; letter-spacing: -.05em; }
	.archive-header > p:last-child { margin: 0; color: var(--muted); font-size: 13px; }
	.archive-tools { margin-bottom: 10px; }
	.archive-tools label { display: block; margin-bottom: 7px; color: var(--muted); font-size: 11px; }
	.archive-tools input { width: 100%; padding: 11px 12px; border: 1px solid var(--line); border-radius: 2px; background: var(--surface); color: var(--ink); font: inherit; font-size: 13px; }
	.archive-tools input::placeholder { color: #777; }
	.archive-tools input:focus { border-color: var(--astro); outline: 1px solid var(--astro); }
	.result-count { margin: 10px 0 0; color: var(--muted); font-size: 10px; }
	.post-item { border-top: 1px solid var(--line); }
	.post-item:last-child { border-bottom: 1px solid var(--line); }
	.post-item[hidden] { display: none; }
	.post-item > a { display: grid; grid-template-columns: 102px 1fr 18px; align-items: baseline; gap: 14px; padding: 17px 2px; text-decoration: none; }
	.post-item time { color: var(--muted); font-size: 11px; white-space: nowrap; }
	.post-copy h2 { margin: 0 0 4px; font-size: 15px; font-weight: 600; line-height: 1.6; }
	.excerpt { color: var(--muted); font-size: 12px; line-height: 1.7; }
	.arrow { color: var(--muted); font-size: 12px; text-align: right; }
	.post-item a:hover h2, .post-item a:hover .arrow { color: var(--astro); }
	.no-results { margin: 22px 0; color: var(--muted); font-size: 13px; }
	.back-link { display: inline-block; margin-top: 25px; color: var(--muted); font-size: 11px; text-decoration: none; }
	.back-link:hover { color: var(--astro); }
	@media (max-width: 600px) { .archive { width: calc(100% - 32px); padding-top: 45px; } h1 { font-size: 31px; } .post-item > a { grid-template-columns: 80px 1fr 14px; gap: 10px; padding: 14px 0; } .post-copy h2 { font-size: 13px; } .excerpt { font-size: 11px; } }
</style>
