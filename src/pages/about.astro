---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head><BaseHead title={`プロフィール | ${SITE_TITLE}`} description="kuroneko52のプロフィール。開発や日々の気づきを記録しています。" /></head>
	<body>
		<Header />
		<main class="about-page">
			<p class="eyebrow">ABOUT</p>
			<h1>プロフィール</h1>
			<p class="lead">kuroneko52（@kuroneko52）です。ソフトウェア開発や日々の気づきを、このブログに記録しています。</p>
			<h2>このサイトについて</h2>
			<p>開発で学んだこと、つくったもの、興味を持ったことを自分の言葉で綴ります。記事は Markdown または MDX で書き、Astro で静的サイトとしてビルドしています。</p>
			<h2>連絡先</h2>
			<p><a href="https://github.com/kuroneko52" rel="me">GitHub: @kuroneko52</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-page { width: min(720px, calc(100% - 40px)); min-height: 55vh; margin: auto; padding: 65px 0 20px; }
	.eyebrow { margin-bottom: 8px; color: var(--astro); font-size: 10px; letter-spacing: .12em; }
	h1 { margin: 0 0 22px; font-size: clamp(32px, 5vw, 40px); font-weight: 500; letter-spacing: -.05em; }
	h2 { margin: 2.5em 0 .7em; font-size: 18px; }
	.about-page p { color: var(--muted); line-height: 2; }
	.about-page .lead { max-width: 580px; color: var(--ink); font-size: 16px; }
	.about-page a { color: var(--astro); text-underline-offset: 3px; }
	@media (max-width: 600px) { .about-page { width: calc(100% - 32px); padding-top: 45px; } }
</style>
