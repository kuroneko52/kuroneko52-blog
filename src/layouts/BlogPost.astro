---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head><BaseHead title={`${title} | ${SITE_TITLE}`} description={description} image={heroImage} /></head>
	<body><Header /><main class="article-page"><nav class="breadcrumbs" aria-label="パンくずリスト"><a href="/">ホーム</a><span>/</span><a href="/blog">記事一覧</a></nav><article><header class="article-header"><p class="eyebrow">{new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' }).format(pubDate)}</p><h1>{title}</h1><p class="description">{description}</p>{updatedDate && <p class="updated">更新日：<FormattedDate date={updatedDate} /></p>}</header>{heroImage && <img class="hero-image" src={heroImage.src} alt="" />}<div class="prose"><slot /></div></article><nav class="article-nav"><a href="/blog">← 記事一覧へ</a><a href="/">ホームへ</a></nav></main><Footer /></body>
</html>

<style>
	.article-page { width: min(720px, calc(100% - 40px)); margin: auto; padding-top: 24px; }
	.breadcrumbs { display: flex; gap: 9px; color: var(--muted); font-size: 10px; }
	.breadcrumbs a { color: var(--muted); text-decoration: none; }
	.breadcrumbs a:hover { color: var(--astro); }
	.article-header { max-width: 640px; margin: auto; padding: 55px 0 31px; }
	.eyebrow { margin-bottom: 14px; color: var(--muted); font-size: 11px; }
	h1 { margin: 0 0 14px; font-size: clamp(29px, 5vw, 42px); font-weight: 500; letter-spacing: -.05em; line-height: 1.55; }
	.description { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.9; }
	.updated { margin: 8px 0 0; color: var(--muted); font-size: 10px; }
	.hero-image { width: 100%; max-height: 360px; margin: 0 0 38px; border-radius: 2px; object-fit: cover; }
	.article-nav { display: flex; justify-content: space-between; margin-top: 42px; padding-top: 15px; border-top: 1px solid var(--line); }
	.article-nav a { color: var(--muted); font-size: 11px; text-decoration: none; }
	.article-nav a:hover { color: var(--astro); }
	@media (max-width: 600px) { .article-page { width: calc(100% - 32px); } .article-header { padding: 39px 0 25px; } }
</style>
